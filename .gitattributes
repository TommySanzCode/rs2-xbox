* text=auto eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.ini text eol=lf
*.bin binary
*.ttf binary

# Keep imported notices and patch context byte-exact, including upstream spacing.
release-notices/xbox/** -text -whitespace
server-package/licenses/** -text -whitespace
server-package/patches/*.patch -text -whitespace
